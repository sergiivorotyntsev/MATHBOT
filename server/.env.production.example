# MathBot Arena Server - Production Environment Variables
# Copy this file to .env.production and fill in your values

# ==================== REQUIRED ====================

# Server Port (use PORT on most cloud platforms)
PORT=3001

# Node Environment
NODE_ENV=production

# Client URL for CORS (your deployed client URL)
CLIENT_URL=https://your-client-domain.com

# ==================== BATTLE CONFIGURATION ====================

# Question time limit in seconds (default: 45)
QUESTION_TIME_LIMIT=45

# Maximum rounds per battle (default: 10)
MAX_ROUNDS=10

# Disconnect timeout in seconds (default: 30)
DISCONNECT_TIMEOUT=30

# Matchmaking interval in milliseconds (default: 2000)
MATCHMAKING_INTERVAL=2000

# ELO K-Factor for ranking calculations (default: 32)
ELO_K_FACTOR=32

# ==================== OPTIONAL ====================

# Database (if you add persistence layer)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (for distributed matchmaking queue)
# REDIS_URL=redis://host:6379

# Logging
# LOG_LEVEL=info
# LOG_FORMAT=json

# Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Security
# JWT_SECRET=your-secret-key-here
# SESSION_SECRET=your-session-secret

# Monitoring
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEW_RELIC_LICENSE_KEY=your-key

# ==================== DEVELOPMENT OVERRIDES ====================
# (Remove these in production)

# Enable debug logging
# DEBUG=socket.io:*

# Disable rate limiting (dev only)
# DISABLE_RATE_LIMIT=true
