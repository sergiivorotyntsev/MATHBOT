# MathBot Arena - Production Environment Variables
# Copy this file to .env.production and fill in your values

# ==================== REQUIRED ====================

# WebSocket Server URL (must use https:// in production)
VITE_SERVER_URL=https://your-server-domain.com

# ==================== OPTIONAL ====================

# Analytics (Google Analytics, Plausible, etc.)
# VITE_ANALYTICS_ID=G-XXXXXXXXXX

# Error Tracking (Sentry)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Feature Flags
# VITE_ENABLE_PVP=true
# VITE_ENABLE_DAILY_QUESTS=true

# API Keys (if needed for future features)
# VITE_API_KEY=your-api-key-here
